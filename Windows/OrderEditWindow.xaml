<Window x:Class="Education.Windows.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Education.Windows"
        mc:Ignorable="d"
        Title="Добавление/редактирование заказа"
        Height="490" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <StackPanel Margin="30">

        <!-- ID (только при редактировании) -->
        <TextBlock x:Name="LblId" Text="ID заказа:"/>
        
        <TextBox x:Name="TxtId"
                 Height="30"
                 Margin="0,4,0,10"
                 IsReadOnly="True"
                 Background="#EEEEEE"/>

        <TextBlock Text="Артикул заказа:"/>
        <TextBox x:Name="TxtCode"
                 Height="30"
                 Margin="0,4,0,10"/>

        <TextBlock Text="Статус заказа:"/>
        <ComboBox x:Name="CmbStatus"
                  Height="30"
                  Margin="0,4,0,10"/>

        <TextBlock Text="Адрес пункта выдачи:"/>
        <ComboBox x:Name="CmbPickupPoint"
                  Height="30"
                  Margin="0,4,0,10"/>

        <TextBlock Text="Дата заказа:"/>
        <DatePicker x:Name="DtOrderDate"
                    Height="30"
                    Margin="0,4,0,10"/>

        <TextBlock Text="Дата выдачи:"/>
        <DatePicker x:Name="DtDeliveryDate"
                    Height="30"
                    Margin="0,4,0,20"/>

        <!-- Кнопки -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Сохранить"
                    Height="35"
                    Margin="0,0,5,0"
                    Click="BtnSave_Click"/>

            <Button Grid.Column="1"
                    Content="Отмена"
                    Height="35"
                    Margin="5,0,0,0"
                    Click="BtnCancel_Click"/>
        </Grid>
    </StackPanel>
</Window>
