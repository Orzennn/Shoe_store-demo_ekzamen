<Window x:Class="Education.Windows.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Education.Windows"
        mc:Ignorable="d"
        Title="Список заказов - ООО Обувь"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="ООО «Обувь» - Заказы"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="10,0"/>

            <TextBlock x:Name="LblUser"
                       Foreground="White"
                       FontSize="13"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,10,0"/>
        </Grid>

        <!-- Кнопки -->
        <WrapPanel Grid.Row="1"
                   VerticalAlignment="Center"
                   Margin="10,0">

            <Button x:Name="BtnAdd"
                    Content="Добавить заказ"
                    Width="130" Height="30"
                    Margin="0,0,8,0"
                    Click="BtnAdd_Click"/>

            <Button x:Name="BtnDelete"
                    Content="Удалить заказ"
                    Width="130" Height="30"
                    Margin="0,0,8,0"
                    Click="BtnDelete_Click"/>

            <Button Content="Назад"
                    Width="80" Height="30"
                    Click="BtnBack_Click"/>

        </WrapPanel>

        <!-- Список заказов -->
        <ListView x:Name="LvOrders"
                  Grid.Row="2"
                  Margin="10"
                  MouseDoubleClick="LvOrders_MouseDoubleClick">

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="№ заказа"
                                    DisplayMemberBinding="{Binding OrderNumber}"
                                    Width="80"/>

                    <GridViewColumn Header="Артикул заказа"
                                    DisplayMemberBinding="{Binding OrderCode}"
                                    Width="100"/>

                    <GridViewColumn Header="Статус"
                                    DisplayMemberBinding="{Binding StatusName}"
                                    Width="120"/>

                    <GridViewColumn Header="Адрес выдачи"
                                    DisplayMemberBinding="{Binding PickupAddress}"
                                    Width="200"/>

                    <GridViewColumn Header="Дата заказа"
                                    DisplayMemberBinding="{Binding OrderDate}"
                                    Width="120"/>

                    <GridViewColumn Header="Дата выдачи"
                                    DisplayMemberBinding="{Binding DeliveryDate}"
                                    Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
