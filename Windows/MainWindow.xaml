<Window x:Class="Education.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Education"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="310" WindowStartupLocation="CenterScreen">
    
    <Grid VerticalAlignment="Center" 
          HorizontalAlignment="Center" 
          Width="200">

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <TextBlock Name="textTitle" 
                   Grid.Row="0" 
                   TextWrapping="Wrap"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Height="22">
            <Bold>Авторизация</Bold>
        </TextBlock>

        <TextBlock Grid.Row="1" Name="textLogin" 
                   TextWrapping="Wrap" 
                   FontSize="12" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom" 
                   TextAlignment="Center" 
                   Margin="5,0,0,0"> 
            <Bold>Логин:</Bold>
        </TextBlock>

        <TextBox Grid.Row="2" 
                 Name="TxtLogin" 
                 TextWrapping="Wrap" 
                 FontSize="14"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" 
                 VerticalContentAlignment="Center" 
                 Width="200" 
                 Height="30"/>

        <TextBlock Grid.Row="3" 
                   Name="textPassword"
                   TextWrapping="Wrap" 
                   FontSize="12" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Bottom" 
                   TextAlignment="Center" 
                   Margin="5,0,0,0">
            <Bold>Пароль:</Bold>
        </TextBlock>

        <PasswordBox Grid.Row="4" 
                     Name="TxtPassword" 
                     FontSize="14" 
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Center" 
                     VerticalContentAlignment="Center" 
                     Width="200" 
                     Height="30">
        </PasswordBox>

        <Button Grid.Row="5" 
                Name="BtnLogin" 
                Width="100" 
                Height="28" 
                Click="BtnLogin_Click">
            Войти
        </Button>

        <Button Grid.Row="6" 
                Name="BtnGuest" 
                Width="100" 
                Height="28" 
                Margin="0,5,0,0"
                Click="BtnGuest_Click">
            Войти как гость
        </Button>
    </Grid>
</Window>
