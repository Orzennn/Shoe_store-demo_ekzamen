<Window x:Class="Education.Windows.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Education.Windows"
        mc:Ignorable="d"
        Title="Список товаров - ООО Обувь"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <!-- шапка -->
            <RowDefinition Height="70"/>
            <!-- панель управления -->
            <RowDefinition Height="*"/>
            <!-- список товаров -->
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="ООО «Обувь»"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="10,0"/>

            <!-- ФИО пользователя справа вверху -->
            <TextBlock x:Name="LblUser"
                       Foreground="White"
                       FontSize="13"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,10,0"/>
        </Grid>

        <!-- Панель управления -->
        <WrapPanel Grid.Row="1"
                   VerticalAlignment="Center"
                   Margin="10,0">

            <!-- Поиск (только менеджер и администратор) -->
            <TextBox x:Name="TxtSearch"
                     Width="200" Height="30"
                     Margin="0,0,8,0"
                     TextChanged="TxtSearch_TextChanged"/>

            <!-- Фильтр по поставщику -->
            <ComboBox x:Name="CmbSupplier"
                      Width="180" Height="30"
                      Margin="0,0,8,0"
                      SelectionChanged="CmbSupplier_SelectionChanged"/>

            <!-- Сортировка -->
            <ComboBox x:Name="CmbSort"
                      Width="200" Height="30"
                      Margin="0,0,8,0"
                      SelectionChanged="CmbSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="Кол-во: по возрастанию"/>
                <ComboBoxItem Content="Кол-во: по убыванию"/>
            </ComboBox>

            <!-- Кнопка заказы -->
            <Button x:Name="BtnOrders"
                    Content="Заказы"
                    Width="90" Height="30"
                    Margin="0,0,8,0"
                    Click="BtnOrders_Click"/>

            <!-- Кнопка добавить -->
            <Button x:Name="BtnAdd"
                    Content="Добавить товар"
                    Width="120" Height="30"
                    Margin="0,0,8,0"
                    Click="BtnAdd_Click"/>

            <!-- Кнопка удалить -->
            <Button x:Name="BtnDelete"
                    Content="Удалить товар"
                    Width="120" Height="30"
                    Margin="0,0,8,0"
                    Click="BtnDelete_Click"/>

            <!-- Выход -->
            <Button Content="Выход"
                    Width="80" Height="30"
                    Click="BtnLogout_Click"/>

        </WrapPanel>

        <!-- Список товаров -->
        <ListView x:Name="LvProducts"
          Grid.Row="2"
          Margin="10"
          MouseDoubleClick="LvProducts_MouseDoubleClick">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="2"/>
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black"
                    BorderThickness="1"
                    Padding="6"
                    Background="{Binding RowBackground}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <!-- Фото -->
                            <Border Grid.Column="0"
                                Width="180"
                                Height="120"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Margin="0,0,8,0"
                                Background="White"
                                ClipToBounds="True">
                                
                               <Image Source="{Binding ImagePath}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Текст по центру -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">

                                <TextBlock FontWeight="Bold">
                            <Run Text="{Binding CategoryName}"/>
                            <Run Text=" | "/>
                            <Run Text="{Binding ProductName}"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap">
                            <Run Text="Описание товара: "/>
                            <Run Text="{Binding Description}"/>
                                </TextBlock>

                                <TextBlock>
                            <Run Text="Производитель: "/>
                            <Run Text="{Binding ManufacturerName}"/>
                                </TextBlock>

                                <TextBlock>
                            <Run Text="Поставщик: "/>
                            <Run Text="{Binding SupplierName}"/>
                                </TextBlock>

                                <!-- Цена: если скидка есть — старая перечёркнута красным + новая -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Цена: "/>

                                    <TextBlock Text="{Binding PriceText}"
                                       Foreground="Red"
                                       TextDecorations="Strikethrough"
                                       Visibility="{Binding StrikeVisibility}"/>

                                    <TextBlock Text="{Binding FinalPriceText}"
                                       Margin="6,0,0,0"/>
                                </StackPanel>

                                <TextBlock>
                            <Run Text="Единица измерения: "/>
                            <Run Text="{Binding UnitName}"/>
                                </TextBlock>

                                <TextBlock>
                            <Run Text="Количество на складе: "/>
                            <Run Text="{Binding QuantityInStock}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Скидка справа -->
                            <Border Grid.Column="2"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Padding="6">
                                <TextBlock Text="{Binding DiscountText}"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
