<Window x:Class="Education.Windows.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Education.Windows"
        mc:Ignorable="d"
        Title="Список товаров - ООО Обувь"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <!-- шапка -->
            <RowDefinition Height="70"/>
            <!-- панель управления -->
            <RowDefinition Height="*"/>
            <!-- список товаров -->
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="ООО «Обувь»"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="10,0"/>

            <!-- ФИО пользователя справа вверху -->
            <TextBlock x:Name="LblUser"
                       Foreground="White"
                       FontSize="13"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,10,0"/>
        </Grid>

        <!-- Панель управления -->
        <WrapPanel Grid.Row="1"
                   VerticalAlignment="Center"
                   Margin="10,0">

            <!-- Поиск (только менеджер и администратор) -->
            <TextBox x:Name="TxtSearch"
                     Width="200" Height="30"
                     Margin="0,0,8,0"
                     TextChanged="TxtSearch_TextChanged"/>

            <!-- Фильтр по поставщику -->
            <ComboBox x:Name="CmbSupplier"
                      Width="180" Height="30"
                      Margin="0,0,8,0"
                      SelectionChanged="CmbSupplier_SelectionChanged"/>

            <!-- Сортировка -->
            <ComboBox x:Name="CmbSort"
                      Width="200" Height="30"
                      Margin="0,0,8,0"
                      SelectionChanged="CmbSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="Кол-во: по возрастанию"/>
                <ComboBoxItem Content="Кол-во: по убыванию"/>
            </ComboBox>

            <!-- Кнопка заказы -->
            <Button x:Name="BtnOrders"
                    Content="Заказы"
                    Width="90" Height="30"
                    Margin="0,0,8,0"
                    Click="BtnOrders_Click"/>

            <!-- Кнопка добавить -->
            <Button x:Name="BtnAdd"
                    Content="Добавить товар"
                    Width="120" Height="30"
                    Margin="0,0,8,0"
                    Click="BtnAdd_Click"/>

            <!-- Кнопка удалить -->
            <Button x:Name="BtnDelete"
                    Content="Удалить товар"
                    Width="120" Height="30"
                    Margin="0,0,8,0"
                    Click="BtnDelete_Click"/>

            <!-- Выход -->
            <Button Content="Выход"
                    Width="80" Height="30"
                    Click="BtnLogout_Click"/>

        </WrapPanel>

        <!-- Список товаров -->
        <ListView x:Name="LvProducts"
                  Grid.Row="2"
                  Margin="10"
                  MouseDoubleClick="LvProducts_MouseDoubleClick">

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Фото" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImagePath}"
                                       Width="60" Height="50"
                                       Stretch="Uniform"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Наименование"
                                    DisplayMemberBinding="{Binding ProductName}"
                                    Width="120"/>

                    <GridViewColumn Header="Категория"
                                    DisplayMemberBinding="{Binding CategoryName}"
                                    Width="120"/>

                    <GridViewColumn Header="Описание"
                                    DisplayMemberBinding="{Binding Description}"
                                    Width="180"/>

                    <GridViewColumn Header="Производитель"
                                    DisplayMemberBinding="{Binding ManufacturerName}"
                                    Width="110"/>

                    <GridViewColumn Header="Поставщик"
                                    DisplayMemberBinding="{Binding SupplierName}"
                                    Width="110"/>

                    <GridViewColumn Header="Цена" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Перечёркнутая цена если есть скидка -->
                                    <TextBlock Text="{Binding PriceText}"
                                               Foreground="Red"
                                               TextDecorations="Strikethrough"
                                               Visibility="{Binding StrikeVisibility}"/>
                                    <TextBlock Text="{Binding FinalPriceText}"
                                               Foreground="Black"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Ед.изм."
                                    DisplayMemberBinding="{Binding UnitName}"
                                    Width="60"/>

                    <GridViewColumn Header="На складе"
                                    DisplayMemberBinding="{Binding QuantityInStock}"
                                    Width="80"/>

                    <GridViewColumn Header="Скидка %"
                                    DisplayMemberBinding="{Binding Discount}"
                                    Width="70"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
